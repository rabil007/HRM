APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Production must use APP_ENV=production and APP_DEBUG=false. The application
# also forces debug off at boot when APP_ENV=production. Prefer LOG_LEVEL=info.

# Privileged 2FA for high-trust actions (payroll approval, roles, credentials, platform).
# Default is off so existing operators can enroll first. Production should set true
# after 2FA setup. See docs/privileged-2fa.md.
# PRIVILEGED_2FA_ENFORCED=true

# Browser security headers (see docs/security-headers.md)
# Production HTTPS: send the session cookie only over TLS.
# SESSION_SECURE_COOKIE=true
# TLS-terminating reverse proxy (Hostinger/nginx). List explicit proxy IPs.
# '*' is ignored: it would let clients spoof X-Forwarded-* (HSTS, IP throttle).
# TRUSTED_PROXIES=10.0.0.1
# Optional CSP report-only rollout (enforced by default).
# SECURITY_CSP_REPORT_ONLY=true
# Optional HSTS override. Unset = on in production when the request is HTTPS.
# SECURITY_HSTS=true
# Local Vite origins (APP_ENV=local only). Hosts must be .test, localhost, or loopback.
# SECURITY_CSP_VITE_ORIGINS=https://oms-hrm.test:5173,wss://oms-hrm.test:5173,http://127.0.0.1:5173,ws://127.0.0.1:5173

# Platform database viewer (cross-tenant). Unset = on outside production, off in production.
# PLATFORM_DATABASE_VIEWER_ENABLED=false

# Employee Directory smart search (beta). Prefer Settings → Application → AI
# for enable/provider/API keys/models. These env values are fallbacks only
# when no stored setting exists. Never commit a real API key.
EMPLOYEE_SMART_SEARCH_ENABLED=false
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Set true temporarily to log onboarding template field visibility (grep: OMS-HRM:template-fields)
TEMPLATE_FIELDS_DEBUG=false
# Herd: use your HTTPS site URL (e.g. https://oms-hrm.test) so storage/favicon
# URLs match the secure browser origin and avoid mixed-content blocks.
APP_URL=https://oms-hrm.test
APP_TIMEZONE=Asia/Dubai

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_LEVEL=info (or warning). Do not leave debug on a public host.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oms_hrm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_ALERT_EMAIL=rabil@overseas-ms.com
DB_QUEUE_RETRY_AFTER=660
REDIS_QUEUE_RETRY_AFTER=660
JOB_RUN_RETENTION_DAYS=90

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Document expiry alerts (daily scheduler + queue worker; To/CC and dispatch time in Settings → Email templates)
DOCUMENT_EXPIRY_ALERT_DAYS=30
DOCUMENT_EXPIRY_ALERT_DISPATCH_AT=08:00

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Browser Web Push (announcement in-app extension). Generate with:
# php artisan webpush:vapid
# Keep these keys stable after production deployment. Never commit real private keys.
VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=


# Browsershot (salary declaration PDF generation on queue worker host)
# On Hostinger, enable Node.js in hPanel first. Common paths are auto-detected:
# /opt/alt/alt-nodejs20/root/usr/bin/node
# After deploy, SSH in and verify: php artisan browsershot:doctor
# If Chrome fails to launch, reinstall: php artisan browsershot:install
# PUPPETEER_CACHE_DIR=/absolute/path/to/storage/app/puppeteer
# BROWSERSHOT_NODE_BINARY=/opt/alt/alt-nodejs20/root/usr/bin/node
# BROWSERSHOT_NPM_BINARY=/opt/alt/alt-nodejs20/root/usr/bin/npm
# BROWSERSHOT_CHROME_PATH=
