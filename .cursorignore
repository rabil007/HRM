# Secrets and private application data must never enter AI context.
.env
.env.*
!.env.example
auth.json
*.pem
*.p12
*.pfx
*.key

# User-generated/private runtime data.
storage/app/**
storage/logs/**
storage/framework/**
storage/*.key
storage/pail/**
database/*.sqlite
database/*.sqlite3
*.sql

# Local reports/runtime output that is not application source.
coverage/**
playwright-report/**
test-results/**
*.log
